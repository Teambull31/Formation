# Copier en .env (jamais commité) et adapter.

# Obligatoire avec docker compose : 12 caractères minimum (ex. : openssl rand -base64 24).
FORMATION_PASSWORD=

# Adresse d'écoute de l'hôte. 127.0.0.1 = machine seule (défaut).
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# Profil https : nom de domaine pointant vers ce serveur.
DOMAIN=

# Propriétaire des fichiers de ./content dans le conteneur (id -u / id -g).
APP_UID=1000
APP_GID=1000

# DANGEREUX (lire DEPLOY.md) : 1 = terminal et TP exécutables à distance par quiconque a le mot de passe.
# Dans Docker, nécessaire pour utiliser terminal et TP même depuis le PC (l'appli voit l'IP de la passerelle Docker).
FORMATION_REMOTE_EXEC=0
# Obligatoire si REMOTE_EXEC=1 : noms d'hôte acceptés dans l'en-tête Host, séparés par des virgules.
FORMATION_ALLOWED_HOSTS=localhost,127.0.0.1
