[Unit]
Description=Formation : recopie les sauvegardes du VPS sur ce PC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# pas de --delete : une sauvegarde effacée sur le VPS reste sur le PC
ExecStart=/usr/bin/rsync -a -e "ssh -o BatchMode=yes -o ConnectTimeout=30" vps:backups/ %h/backups-formation/
